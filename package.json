{
  "name": "kairos-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kairos Archive's Discord bot: Sorcery: Contested Realm cards by slash command, served from api.kairosarchive.net on a Cloudflare Worker.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "register": "node scripts/register.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "bundle": "wrangler deploy --dry-run --outdir dist"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260915.1",
    "eslint": "^10.10.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.132.0"
  }
}
